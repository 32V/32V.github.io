<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle">{{ content.date | escape }}</span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.name }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4">{{ content.position }} · {{ content.organization }}</h6>
          {% if content.summary %}
            <p class="ml-1 ml-md-4 mb-0">{{ content.summary }}</p>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
